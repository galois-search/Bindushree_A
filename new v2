import numpy as np
import os
import time
from datetime import datetime

def get_base_legendre_sequence(n):
    """✅ TRUE LEGENDRE SYMBOL: χ(i) = (i/p)"""
    def is_prime(num):
        if num < 2: return False
        for i in range(2, int(num ** 0.5) + 1):
            if num % i == 0: return False
        return True

    def quadratic_character(x, p):
        if x == 0: return 1
        val = pow(x, (p - 1) // 2, p)
        return 1 if val == 1 else -1

    p = n
    while not is_prime(p):
        p += 1
    print(f"✅ Prime p = {p}")
    base_chi = np.array([quadratic_character(i, p) for i in range(p)], dtype=float)
    print("✅ TRUE Legendre χ(i) ready")
    return base_chi, p

def generate_pure_weil_shift(base_chi, p, n, k):
    """✅ TRUE WEIL: w_i = χ(i) × χ(i+k)"""
    chi_shifted = np.roll(base_chi, k)
    weil_seq = base_chi * chi_shifted
    return weil_seq[:n].astype(float)

def compute_psl(seq, n):
    autocorr = np.round(np.real(np.fft.ifft(np.fft.fft(seq) * np.conj(np.fft.fft(seq))))).astype(float)
    return int(np.max(np.abs(autocorr[1:n // 2 + 1])))

def compute_balance(seq):
    ones = int(np.sum(seq > 0))
    return abs(ones - (len(seq) - ones))

def get_smart_balance_limits(n):
    if n % 2 == 0:
        return [0, 2, 4, 6], 6
    else:
        return [1, 3, 5, 7], 7

def is_valid_balance(balance, n):
    return (balance % 2 == n % 2)

# 🚀 ULTRA PSL OPTIMIZATION FUNCTIONS
def compute_psl_energy(acf, sl):
    return np.sum(np.abs(acf[sl]) ** 3)

def compute_psl_diff(delta, acf, sl, gamma=3.0):
    return np.sum(np.abs(acf[sl] + delta[sl]) ** gamma) - np.sum(np.abs(acf[sl]) ** gamma)

def advanced_psl_optimize(seq, n, max_steps=150000, temp=8.0, cooling=0.9997):
    """🔥 TECHNIQUE 1: Enhanced Simulated Annealing"""
    valid_balances, max_target = get_smart_balance_limits(n)
    
    best_seq = seq.copy()
    best_psl = compute_psl(seq, n)
    best_balance = compute_balance(seq)
    
    current_seq = seq.copy()
    f_vec = np.fft.fft(current_seq)
    acf = np.round(np.real(np.fft.ifft(f_vec * np.conj(f_vec)))).astype(float)
    sl = slice(1, n // 2 + 1)
    
    gamma = 3.0
    
    for step in range(max_steps):
        idx = np.random.randint(0, n)
        diff = -2 * current_seq[idx]
        delta = diff * (current_seq[(idx - np.arange(n)) % n] + current_seq[(idx + np.arange(n)) % n])
        
        delta_score = compute_psl_diff(delta, acf, sl, gamma)
        
        if delta_score < 0 or np.random.rand() < np.exp(-delta_score / temp):
            current_seq[idx] *= -1
            acf += delta
            
            new_balance = compute_balance(current_seq)
            if new_balance <= max_target and is_valid_balance(new_balance, n):
                curr_psl = int(np.max(np.abs(acf[sl])))
                if curr_psl < best_psl or (curr_psl == best_psl and new_balance < best_balance):
                    best_psl = curr_psl
                    best_balance = new_balance
                    best_seq = current_seq.copy()
                
                gamma = min(6.0, gamma + 0.001)
            else:
                current_seq[idx] *= -1
                acf -= delta
        
        temp *= cooling
        
        if step % 25000 == 0 and step > 0:
            print(f"     SA[{step//25000}]: PSL={best_psl}, Bal={best_balance}, T={temp:.2f}")
    
    return best_seq, best_psl, best_balance

def block_optimize(seq, n, block_size=12):
    """🔥 TECHNIQUE 2: Block-wise Exhaustive Search"""
    best_seq = seq.copy()
    best_psl = compute_psl(seq, n)
    best_balance = compute_balance(seq)
    
    valid_balances, max_target = get_smart_balance_limits(n)
    
    print(f"     Block size: {block_size}")
    
    for start in range(0, n, block_size):
        end = min(start + block_size, n)
        block_len = end - start
        
        # Try all 2^block_len combinations (feasible for small blocks)
        for mask in range(1 << block_len):
            test_seq = best_seq.copy()
            flips = 0
            
            for j in range(block_len):
                if mask & (1 << j):
                    test_seq[start + j] *= -1
                    flips += 1
            
            # Check balance constraint
            new_balance = compute_balance(test_seq)
            if new_balance <= max_target and is_valid_balance(new_balance, n):
                test_psl = compute_psl(test_seq, n)
                if test_psl < best_psl or (test_psl == best_psl and new_balance < best_balance):
                    best_seq = test_seq.copy()
                    best_psl = test_psl
                    best_balance = new_balance
    
    print(f"     Block: PSL={best_psl}, Bal={best_balance}")
    return best_seq, best_psl, best_balance

def tabu_search_optimize(seq, n, tabu_size=30, max_steps=30000):
    """🔥 TECHNIQUE 3: Tabu Search"""
    valid_balances, max_target = get_smart_balance_limits(n)
    
    current_seq = seq.copy()
    best_seq = seq.copy()
    best_psl = compute_psl(seq, n)
    best_balance = compute_balance(seq)
    
    tabu_list = []
    f_vec = np.fft.fft(current_seq)
    acf = np.round(np.real(np.fft.ifft(f_vec * np.conj(f_vec)))).astype(float)
    sl = slice(1, n // 2 + 1)
    
    for step in range(max_steps):
        candidates = []
        
        for idx in range(n):
            if idx not in tabu_list[-tabu_size:]:
                diff = -2 * current_seq[idx]
                delta = diff * (current_seq[(idx - np.arange(n)) % n] + 
                               current_seq[(idx + np.arange(n)) % n])
                
                new_balance = compute_balance(current_seq * np.where(diff > 0, 1, -1))
                if new_balance <= max_target and is_valid_balance(new_balance, n):
                    score = compute_psl_diff(delta, acf, sl)
                    candidates.append((idx, score))
        
        if candidates:
            best_idx, best_score = min(candidates, key=lambda x: x[1])
            
            diff = -2 * current_seq[best_idx]
            delta = diff * (current_seq[(best_idx - np.arange(n)) % n] + 
                           current_seq[(best_idx + np.arange(n)) % n])
            
            current_seq[best_idx] *= -1
            acf += delta
            tabu_list.append(best_idx)
            if len(tabu_list) > tabu_size * 2:
                tabu_list.pop(0)
            
            curr_psl = int(np.max(np.abs(acf[sl])))
            if curr_psl < best_psl:
                best_psl = curr_psl
                best_seq = current_seq.copy()
                best_balance = compute_balance(current_seq)
    
    print(f"     Tabu: PSL={best_psl}, Bal={best_balance}")
    return best_seq, best_psl, best_balance

def ultra_psl_optimize(seq, n):
    """🎯 ULTRA 3-STAGE PSL PIPELINE (Simplified for speed)"""
    print("🔥 ULTRA PSL (SA → Blocks → Tabu)...")
    
    valid_balances, max_target = get_smart_balance_limits(n)
    
    # Stage 1: Simulated Annealing (heavy lifting)
    print("  1. Simulated Annealing...")
    seq_sa, psl_sa, bal_sa = advanced_psl_optimize(seq.copy(), n)
    
    # Stage 2: Block optimization
    print("  2. Block Optimization...")
    block_size = max(8, min(16, n // 16))
    seq_block, psl_block, bal_block = block_optimize(seq_sa, n, block_size)
    
    # Stage 3: Tabu Search (final polish)
    print("  3. Tabu Search...")
    final_seq, final_psl, final_bal = tabu_search_optimize(seq_block, n)
    
    print(f"✅ ULTRA COMPLETE: {psl_sa}→{psl_block}→{final_psl}")
    return final_seq, final_psl, final_bal

def optimize_balance_auto(seq, n, max_flips=10000):
    """Phase 0: Quick Balance Fix"""
    valid_balances, max_target = get_smart_balance_limits(n)
    target_ones = n // 2
    ones = int(np.sum(seq > 0))
    flips = 0
    
    while (compute_balance(seq) > max_target or not is_valid_balance(compute_balance(seq), n)) and flips < max_flips:
        if ones > target_ones + 2:
            candidates = np.where(seq > 0)[0]
            if len(candidates) > 0:
                idx = np.random.choice(candidates)
                seq[idx] *= -1
                ones -= 1
        elif ones < target_ones - 2:
            candidates = np.where(seq < 0)[0]
            if len(candidates) > 0:
                idx = np.random.choice(candidates)
                seq[idx] *= -1
                ones += 1
        flips += 1
    
    return seq, flips, compute_balance(seq)

def save_sequence_to_file(filename, seq, k, n, p, init_psl, final_psl, init_bal, final_bal, bal_flips, bal_phase1, duration, max_bal):
    """🚀 IMMEDIATE SAVE"""
    valid_balances, _ = get_smart_balance_limits(n)
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    
    with open(filename, "a", encoding='utf-8') as f:
        f.write(f"\n{'='*120}\n")
        f.write(f"✅ ULTRA WEIL(k={k:5d}) | N={n:5d} | p={p:5d} | {timestamp}\n")
        f.write(f"PSL: {init_psl:4d} → {final_psl:4d} | Bal: {init_bal:3d} → {final_bal:3d} "
                f"| ULTRA | {duration:6.2f}s\n")
        f.write(f"Valid Bal: {valid_balances} | FinalBal OK: {'✅' if final_bal in valid_balances else '❌'}\n")
        f.write(f"{'='*120}\n")
        
        s_str = "".join(['1' if x > 0 else '0' for x in seq])
        for j in range(0, len(s_str), 80):
            f.write(s_str[j:j + 80] + "\n")
        f.write("\n")

def optimize_single_sequence(seq, n):
    """COMPLETE ULTRA OPTIMIZATION"""
    shift_start = time.time()
    
    init_psl = compute_psl(seq, n)
    init_balance = compute_balance(seq)
    print(f"    Init: PSL={init_psl}, Bal={init_balance}")
    
    # Quick balance fix first
    seq_bal, bal_flips, bal_final = optimize_balance_auto(seq.copy(), n)
    
    # ULTRA PSL optimization
    best_seq, final_psl, final_balance = ultra_psl_optimize(seq_bal, n)
    
    duration = time.time() - shift_start
    valid_balances, max_bal = get_smart_balance_limits(n)
    
    print(f"✅ FINAL: PSL={final_psl}, Bal={final_balance} ({duration:.1f}s)")
    
    return (best_seq, init_psl, final_psl, init_balance, final_balance,
            bal_flips, bal_final, duration, max_bal)

