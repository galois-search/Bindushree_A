import numpy as np
import os
import time
from datetime import datetime


def get_base_legendre_sequence(n):
    """✅ TRUE LEGENDRE SYMBOL: χ(i) = (i/p)"""
    def is_prime(num):
        if num < 2: return False
        for i in range(2, int(num ** 0.5) + 1):
            if num % i == 0: return False
        return True

    def quadratic_character(x, p):
        if x == 0: return 1
        val = pow(x, (p - 1) // 2, p)
        return 1 if val == 1 else -1

    p = n
    while not is_prime(p):
        p += 1
    print(f"✅ Prime p = {p}")

    # ✅ CORRECT: χ(i) for i = 0,1,2,...,p-1
    base_chi = np.array([quadratic_character(i, p) for i in range(p)], dtype=float)
    print("✅ TRUE Legendre χ(i) ready")
    return base_chi, p


def generate_pure_weil_shift(base_chi, p, n, k):
    """✅ TRUE WEIL: w_i = χ(i) × χ(i+k)"""
    # Shift by k positions
    chi_shifted = np.roll(base_chi, k)
    # Pointwise multiplication (XOR equivalent for ±1)
    weil_seq = base_chi * chi_shifted
    return weil_seq[:n].astype(float)  # Truncate to length n


def compute_psl(seq, n):
    autocorr = np.round(np.real(np.fft.ifft(np.fft.fft(seq) * np.conj(np.fft.fft(seq))))).astype(float)
    return int(np.max(np.abs(autocorr[1:n // 2 + 1])))


def compute_balance(seq):
    ones = int(np.sum(seq > 0))
    return abs(ones - (len(seq) - ones))


def get_smart_balance_limits(n):
    """🧠 AUTO: Even=0,2,4,6 | Odd=1,3,5,7"""
    if n % 2 == 0:
        return [0, 2, 4, 6], 6
    else:
        return [1, 3, 5, 7], 7


def is_valid_balance(balance, n):
    return (balance % 2 == n % 2)


def optimize_balance_auto(seq, n, max_flips=15000):
    """PHASE 1: Force proper balance"""
    valid_balances, max_target = get_smart_balance_limits(n)
    target_ones = n // 2
    ones = int(np.sum(seq > 0))
    flips = 0
    
    while (compute_balance(seq) > max_target or not is_valid_balance(compute_balance(seq), n)) and flips < max_flips:
        if ones > target_ones + 3:
            candidates = np.where(seq > 0)[0]
            if len(candidates) > 0:
                idx = np.random.choice(candidates)
                seq[idx] *= -1
                ones -= 1
        elif ones < target_ones - 3:
            candidates = np.where(seq < 0)[0]
            if len(candidates) > 0:
                idx = np.random.choice(candidates)
                seq[idx] *= -1
                ones += 1
        flips += 1
    
    return seq, flips, compute_balance(seq)


def optimize_psl_protected(seq, n, max_steps=100000):
    """PHASE 2+3: PSL optimization + balance protection"""
    valid_balances, max_target = get_smart_balance_limits(n)
    
    best_seq = seq.copy()
    best_psl = compute_psl(seq, n)
    best_balance = compute_balance(seq)
    
    f_vec = np.fft.fft(seq)
    acf = np.round(np.real(np.fft.ifft(f_vec * np.conj(f_vec)))).astype(float)
    gamma = 3.0
    
    for step in range(max_steps):
        idx = np.random.randint(0, n)
        diff = -2 * seq[idx]
        delta = diff * (seq[(idx - np.arange(n)) % n] + seq[(idx + np.arange(n)) % n])
        sl = slice(1, n // 2 + 1)
        
        if np.sum(np.abs(acf[sl] + delta[sl]) ** gamma) < np.sum(np.abs(acf[sl]) ** gamma):
            seq[idx] *= -1
            acf += delta
            
            new_balance = compute_balance(seq)
            if new_balance <= max_target and is_valid_balance(new_balance, n):
                curr_psl = int(np.max(np.abs(acf[sl])))
                if curr_psl < best_psl or (curr_psl == best_psl and new_balance < best_balance):
                    best_psl = curr_psl
                    best_balance = new_balance
                    best_seq = seq.copy()
                gamma = min(20, gamma + 0.01)
            else:
                seq[idx] *= -1
                acf -= delta
    
    return best_seq, best_psl, best_balance


def save_sequence_to_file(filename, seq, k, n, p, init_psl, final_psl, init_bal, final_bal, bal_flips, bal_phase1, duration, max_bal):
    """🚀 IMMEDIATE SAVE after each k"""
    valid_balances, _ = get_smart_balance_limits(n)
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    
    with open(filename, "a", encoding='utf-8') as f:
        f.write(f"\n{'='*120}\n")
        f.write(f"✅ TRUE WEIL(k={k:5d}) | N={n:5d} | p={p:5d} | {timestamp}\n")
        f.write(f"PSL: {init_psl:4d} → {final_psl:4d} | Bal: {init_bal:3d} → {final_bal:3d} "
                f"| Flips:{bal_flips:5d} | Phase1:{bal_phase1:2d} | {duration:6.2f}s\n")
        f.write(f"Valid Bal: {valid_balances} | FinalBal OK: {'✅' if final_bal in valid_balances else '❌'}\n")
        f.write(f"{'='*120}\n")
        
        # Print sequence in blocks
        s_str = "".join(['1' if x > 0 else '0' for x in seq])
        for j in range(0, len(s_str), 80):
            f.write(s_str[j:j + 80] + "\n")
        f.write("\n")


def optimize_single_sequence(seq, n):
    """COMPLETE 3-PHASE OPTIMIZATION"""
    shift_start = time.time()
    
    init_psl = compute_psl(seq, n)
    init_balance = compute_balance(seq)
    
    # PHASE 1: Balance
    seq_bal, bal_flips, bal_phase1 = optimize_balance_auto(seq.copy(), n)
    
    # PHASE 2+3: PSL + Protection
    best_seq, final_psl, final_balance = optimize_psl_protected(seq_bal, n)
    
    duration = time.time() - shift_start
    valid_balances, max_bal = get_smart_balance_limits(n)
    
    return (best_seq, init_psl, final_psl, init_balance, final_balance,
            bal_flips, bal_phase1, duration, max_bal)


def run_pure_weil_optimization():
    """🎯 FULL FEATURE TRUE WEIL OPTIMIZER"""
    n = int(input("Enter sequence length N: "))
    valid_balances, max_balance = get_smart_balance_limits(n)
    
    print(f"\n🎯 Target Balance: ≤{max_balance} | Valid: {valid_balances}")
    
    print("\n🔄 Computing TRUE Legendre sequence χ(i)...")
    base_chi, p = get_base_legendre_sequence(n)
    
    max_k = (p - 1) // 2
    print(f"\n📊 TRUE Weil shifts: k=0 to {max_k}")
    
    # ✅ USER INPUT FOR k RANGE
    start_k = int(input(f"Start k (0-{max_k}): ") or "0")
    stop_k = int(input(f"Stop k ({start_k}-{max_k}): ") or str(min(max_k, 500)))
    
    if start_k < 0 or stop_k > max_k or start_k > stop_k:
        print("❌ Invalid k range!")
        return
    
    num_shifts = stop_k - start_k + 1
    filename = f"TRUE_Weil_N{n}_p{p}_k{start_k}-{stop_k}_Bal{max_balance}.txt"
    
    # 📝 CREATE HEADER
    with open(filename, "w", encoding='utf-8') as f:
        f.write("🚀 TRUE PURE WEIL OPTIMIZER - χ(i) × χ(i+k)\n")
        f.write(f"N={n} | p={p} | k={start_k}-{stop_k} | AutoBal≤{max_balance}\n")
        f.write("✅ 3-Phase: Balance→PSL→Protection | IMMEDIATE SAVES\n")
        f.write("=" * 120 + "\n")
    
    print(f"\n🚀 Processing {num_shifts} TRUE Weil shifts → {filename}")
    print("📝 Each optimized sequence SAVED IMMEDIATELY\n")
    
    best_psl = float('inf')
    best_balance = float('inf')
    best_k = None
    
    for k in range(start_k, stop_k + 1):
        print(f"🔄 k={k:4d}/{stop_k} ({k-start_k+1}/{num_shifts})", end=" ... ")
        
        # ✅ TRUE WEIL GENERATION
        seq = generate_pure_weil_shift(base_chi, p, n, k)
        result = optimize_single_sequence(seq, n)
        
        (best_seq, init_psl, final_psl, init_bal, final_bal,
         bal_flips, bal_phase1, duration, max_bal) = result
        
        # 🚀 IMMEDIATE SAVE TO FILE
        save_sequence_to_file(filename, best_seq, k, n, p, init_psl, final_psl, 
                            init_bal, final_bal, bal_flips, bal_phase1, duration, max_bal)
        
        print(f"PSL:{init_psl:2d}→{final_psl:2d} Bal:{init_bal:2d}→{final_bal:2d} {duration:4.1f}s")
        
        # Track global best
        if final_psl < best_psl or (final_psl == best_psl and final_bal < best_balance):
            best_psl = final_psl
            best_balance = final_bal
            best_k = k
            print(f"   🏆 NEW BEST: PSL={final_psl}, Bal={final_bal}")
    
    # 📊 FINAL SUMMARY
    print(f"\n{'='*80}")
    print(f"🏆 BEST TRUE WEIL: k={best_k:4d} | PSL={best_psl:3d} | Bal={best_balance:2d}")
    print(f"📁 COMPLETE RESULTS: {filename}")
    print(f"{'='*80}")


if __name__ == "__main__":
    print("🚀 TRUE PURE WEIL SEQUENCE OPTIMIZER")
    print("✅ Mathematically correct: χ(i) × χ(i+k)")
    print("✅ 3-Phase optimization + IMMEDIATE file saves")
