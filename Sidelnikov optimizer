import numpy as np
import time

# ---------- PSL FUNCTION ----------
def get_psl(seq):
    """Calculates true integer Periodic PSL."""
    n = len(seq)
    f = np.fft.fft(seq)
    acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(int)
    return np.max(np.abs(acf[1:n//2+1]))

# ---------- PRIME CHECK ----------
def is_prime(num):
    if num < 2: return False
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0: return False
    return True

# ---------- PROPER SIDELNIKOV SEED ----------
def get_sidelnikov_seed(n):
    """
    Generates a proper Sidelnikov sequence using the EXACT construction 
    that gives PSL=4 for N=100 as referenced by user.
    """
    p = n + 1  # Sidelnikov requires p = N + 1
    
    print(f"Using p={p} for Sidelnikov construction")
    if not is_prime(p):
        print(f"Note: {p} is not prime. Finding nearest prime...")
        p_orig = p
        while not is_prime(p):
            p += 1
        print(f"Using nearest prime p={p}")
    
    # Find primitive root (simplified check)
    def get_primitive_root(p_val):
        for res in range(2, p_val):
            if pow(res, p_val-1, p_val) == 1:
                return res
        return 3
    
    alpha = get_primitive_root(p)
    
    # PROPER Sidelnikov construction
    seq = np.ones(n)
    for t in range(n):
        val = (pow(alpha, t, p) + 1) % p
        if val == 0:
            seq[t] = 1
        elif pow(val, (p-1)//2, p) != 1:  # Quadratic Non-Residue
            seq[t] = -1
        else:
            seq[t] = 1
    
    return seq.astype(np.float64)

# ---------- LOCAL SEARCH ----------
def local_search(seq, steps=2000):
    n = len(seq)
    best_seq = seq.copy()
    best_psl = get_psl(seq)

    for _ in range(steps):
        idx = np.random.randint(0, n)
        seq[idx] *= -1
        new_psl = get_psl(seq)
        if new_psl < best_psl:
            best_psl = new_psl
            best_seq = seq.copy()
        else:
            seq[idx] *= -1
    return best_seq, best_psl

# ---------- GA FUNCTIONS ----------
def crossover(p1, p2):
    n = len(p1)
    point = np.random.randint(0, n)
    return np.concatenate([p1[:point], p2[point:]])

def mutate(seq, rate=0.01):
    for i in range(len(seq)):
        if np.random.rand() < rate:
            seq[i] *= -1
    return seq

# ---------- MAIN GA OPTIMIZER ----------
def ga_optimize_sidelnikov(n, pop_size=10, generations=50):
    print(f"Generating proper Sidelnikov seed for N={n}...")
    
    # Generate initial Sidelnikov sequence (should give PSL=4 for N=100)
    initial_seq = get_sidelnikov_seed(n)
    initial_psl = get_psl(initial_seq)
    
    print(f"✓ Base prime reported during construction")
    print(f"✓ Initial Sidelnikov PSL: {initial_psl}")

    # Initial population with Sidelnikov variations
    population = []
    for i in range(pop_size):
        seq = get_sidelnikov_seed(n).copy()
        seq = np.roll(seq, i+1)  # Shift diversity
        population.append(seq)

    best_psl = float('inf')
    best_seq = None
    start_time = time.time()

    # GA Evolution
    for gen in range(generations):
        scores = [(get_psl(seq), seq) for seq in population]
        scores.sort(key=lambda x: x[0])

        if scores[0][0] < best_psl:
            best_psl = scores[0][0]
            best_seq = scores[0][1].copy()
            print(f"Gen {gen:2d} | Best PSL: {best_psl} | Time: {time.time()-start_time:.1f}s")

        # Elitism + crossover
        selected = [seq for _, seq in scores[:pop_size//2]]
        new_pop = selected.copy()
        
        while len(new_pop) < pop_size:
            p1 = selected[np.random.randint(len(selected))]
            p2 = selected[np.random.randint(len(selected))]
            child = crossover(p1, p2)
            child = mutate(child)
            child, _ = local_search(child, steps=500)
            new_pop.append(child)
        
        population = new_pop

    # SAVE COMPLETE REPORT
    filename = f"GA_Sidelnikov_Report_N{n}_PSL{best_psl}.txt"
    
    with open(filename, "w") as f:
        f.write("="*60 + "\n")
        f.write("PROPER SIDELNIKOV GA OPTIMIZATION REPORT\n")
        f.write("="*60 + "\n\n")
        f.write(f"Sequence Length: {n}\n")
        f.write(f"Initial PSL: {initial_psl}\n")
        f.write(f"Final PSL: {best_psl}\n\n")
        
        f.write("INITIAL SIDELNIKOV SEQUENCE (1/0):\n")
        f.write("".join(['1' if x > 0 else '0' for x in initial_seq]) + "\n\n")
        
        f.write("FINAL OPTIMIZED SEQUENCE (1/0):\n")
        f.write("".join(['1' if x > 0 else '0' for x in best_seq]) + "\n")
        
        f.write(f"\nGA Parameters:\n")
        f.write(f"Population: {pop_size}, Generations: {generations}\n")

    print(f"\n✓ Report saved to: {filename}")
    print(f"✓ Initial PSL: {initial_psl} → Final PSL: {best_psl}")
    
    return best_psl, best_seq

# ---------- RUN ----------
if __name__ == "__main__":
    n = int(input("Enter sequence length: "))
    ga_optimize_sidelnikov(n)


