import numpy as np
import random
import math

# -------------------------------
# Sidelnikov Sequence (PROPER)
# -------------------------------
def sidelnikov_sequence(N):
    def is_prime(x):
        for i in range(2, int(x**0.5)+1):
            if x % i == 0:
                return False
        return x > 1

    # Sidelnikov uses p = N + 1
    p = N + 1
    p_used = p
    
    # Find nearest prime if N+1 not prime
    if not is_prime(p):
        print(f"Note: p={p} not prime, finding nearest prime...")
        while not is_prime(p):
            p += 1
        p_used = p
        print(f"Using p={p} for Sidelnikov construction")

    # Find primitive root (simplified)
    def get_primitive_root(p_val):
        for res in range(2, p_val):
            if pow(res, p_val-1, p_val) == 1:
                return res
        return 3

    alpha = get_primitive_root(p)
    
    # PROPER Sidelnikov construction
    seq = np.ones(N)
    for t in range(N):
        val = (pow(alpha, t, p) + 1) % p
        if val == 0:
            seq[t] = 1
        elif pow(val, (p-1)//2, p) != 1:  # Quadratic non-residue
            seq[t] = -1
        else:
            seq[t] = 1
            
    print(f"Sidelnikov constructed using prime p={p_used}")
    return seq

# -------------------------------
# ACF + PSL
# -------------------------------
def acf_fft(x):
    X = np.fft.fft(x)
    acf = np.fft.ifft(X * np.conj(X)).real
    return np.round(acf).astype(int)

def PSL(x):
    return np.max(np.abs(acf_fft(x)[1:]))

# -------------------------------
# MOVES
# -------------------------------
def flip_bits(seq, k=1):
    idx = np.random.choice(len(seq), k, replace=False)
    seq[idx] *= -1
    return seq

def block_flip(seq):
    n = len(seq)
    start = random.randint(0, n-1)
    length = random.randint(5, 50)
    end = min(n, start+length)
    seq[start:end] *= -1
    return seq

def spectral_perturb(seq):
    X = np.fft.fft(seq)
    noise = np.exp(1j*np.random.uniform(0,2*np.pi,len(seq)))
    X = X * noise
    return np.sign(np.fft.ifft(X).real)

# -------------------------------
# Target Peak Reduction
# -------------------------------
def reduce_peak(seq):
    acf = acf_fft(seq)
    k = np.argmax(np.abs(acf[1:])) + 1

    for _ in range(20):
        i = random.randint(0, len(seq)-1)
        seq[i] *= -1
        new_acf = acf_fft(seq)

        if abs(new_acf[k]) < abs(acf[k]):
            return seq
        else:
            seq[i] *= -1

    return seq

# -------------------------------
# Hybrid SA Optimization
# -------------------------------
def hybrid_optimize(seq, iters=15000, temp=60, cooling=0.9995):

    current = seq.copy()
    current_psl = PSL(current)

    best = current.copy()
    best_psl = current_psl

    for i in range(iters):

        new = current.copy()

        move = random.choice(["bit", "multi", "block", "spectral", "target"])

        if move == "bit":
            new = flip_bits(new, 1)

        elif move == "multi":
            new = flip_bits(new, random.randint(2,10))

        elif move == "block":
            new = block_flip(new)

        elif move == "spectral":
            new = spectral_perturb(new)

        else:
            new = reduce_peak(new)

        new_psl = PSL(new)
        delta = new_psl - current_psl

        if delta < 0 or random.random() < math.exp(-delta/temp):
            current = new
            current_psl = new_psl

            if new_psl < best_psl:
                best = new
                best_psl = new_psl

        temp *= cooling

        if i % 2000 == 0:
            print(f"[Iter {i}] Best PSL: {best_psl}")

    return best, best_psl

# -------------------------------
# MAIN
# -------------------------------
if __name__ == "__main__":

    N = int(input("Enter sequence length: "))

    # Initial Sidelnikov sequence (REPLACES Weil)
    print("Generating Sidelnikov sequence...")
    initial_seq = sidelnikov_sequence(N)

    initial_psl = PSL(initial_seq)
    best_global = initial_seq.copy()
    best_psl = initial_psl

    print("Initial PSL:", initial_psl)
    print("✓ Sidelnikov construction complete!")

    # MULTI-RUN (important)
    runs = 5

    for r in range(runs):
        print(f"\n=== RUN {r+1} ===")

        seq_opt, psl = hybrid_optimize(best_global)

        if psl < best_psl:
            best_psl = psl
            best_global = seq_opt

        print("Run PSL:", psl)
        print("Best so far:", best_psl)

    print("\nFINAL BEST PSL:", best_psl)

    # -------------------------------
    # SAVE REPORT
    # -------------------------------
    filename = f"sidelnikov_hybrid_report_{N}_PSL{best_psl}.txt"

    with open(filename, "w") as f:
        f.write(f"Sequence Length: {N}\n\n")

        # INITIAL
        f.write("INITIAL SIDELNIKOV SEQUENCE\n")
        f.write(f"Initial PSL: {initial_psl}\n")
        f.write("Sequence (1/0):\n")
        f.write("".join(['1' if x > 0 else '0' for x in initial_seq]))
        f.write("\n\n")

        # FINAL
        f.write("OPTIMIZED SEQUENCE\n")
        f.write(f"Final PSL: {best_psl}\n")
        f.write("Sequence (1/0):\n")
        f.write("".join(['1' if x > 0 else '0' for x in best_global]))
        f.write("\n")

    print(f"\nReport saved to {filename}")

