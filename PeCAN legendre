import numpy as np
import time

def is_prime(n):
    if n < 2: return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0: return False
    return True

def get_legendre_seed(target_n):
    """Finds nearest prime p <= target_n and creates a Legendre sequence."""
    p = target_n
    while p > 2 and not is_prime(p):
        p -= 1
    
    # Construction of Legendre sequence for prime p
    l_seq = np.ones(p, dtype=int)
    for i in range(1, p):
        if pow(i, (p - 1) // 2, p) == p - 1:
            l_seq[i] = -1
            
    # 'The Patch': Adding random bits to reach target_n
    padding_len = target_n - p
    if padding_len > 0:
        padding = np.random.choice([-1, 1], size=padding_len)
        full_seq = np.concatenate([l_seq, padding])
    else:
        full_seq = l_seq
        
    return full_seq, p, padding_len

def get_metrics(s):
    """Fast Periodic ACF calculation."""
    n = len(s)
    S = np.fft.fft(s)
    acf = np.real(np.fft.ifft(S * np.conj(S)))
    rounded_acf = np.round(acf).astype(int)
    psl = np.max(np.abs(rounded_acf[1:]))
    return psl, rounded_acf

def deep_optimize(n_target):
    # 1. Initialize with Legendre Seed
    initial_seq, prime_p, patch_len = get_legendre_seed(n_target)
    init_psl, _ = get_metrics(initial_seq)
    
    print(f"\n[PHASE 1] Construction")
    print(f"Target Length: {n_target}")
    print(f"Prime Core Used (p): {prime_p}")
    print(f"Patch Length Added: {patch_len}")
    print(f"Initial PSL: {init_psl}")
    
    # 2. Optimization Loop
    current_s = initial_seq.copy()
    best_s = initial_seq.copy()
    best_psl = init_psl
    
    stagnation = 0
    iteration = 0
    print(f"\n[PHASE 2] Optimizing... (Ctrl+C to finish early)")
    
    try:
        # Run until it stops improving for 1000 steps
        while stagnation < 1000:
            iteration += 1
            S = np.fft.fft(current_s)
            
            # Apply Adaptive Spectral Shaping (2026 Heuristic)
            noise = (stagnation / 1000) * 0.1
            target_mag = np.sqrt(n_target) + np.random.normal(0, noise, n_target)
            S_ideal = target_mag * np.exp(1j * np.angle(S))
            
            s_cont = np.real(np.fft.ifft(S_ideal))
            candidate_s = np.where(s_cont >= 0, 1, -1)
            
            curr_psl, _ = get_metrics(candidate_s)
            
            if curr_psl < best_psl:
                best_psl = curr_psl
                best_s = candidate_s.copy()
                stagnation = 0
                if iteration % 10 == 0:
                    print(f"Iter {iteration}: New PSL = {best_psl}")
            else:
                stagnation += 1
            
            # Kick mechanism: if stuck, flip 'uncertain' bits
            if stagnation > 200 and stagnation % 100 == 0:
                uncertainty = np.abs(s_cont)
                threshold = np.percentile(uncertainty, 2)
                candidate_s[uncertainty < threshold] *= -1
            
            current_s = candidate_s
            
    except KeyboardInterrupt:
        print("\nUser stopped the search. Finalizing files...")

    return initial_seq, best_s, best_psl, prime_p, patch_len

# --- Main Execution ---
if __name__ == "__main__":
    N = int(input("Enter target sequence length (e.g. 10230): "))
    
    init_s, final_s, final_p, p_used, patch_p = deep_optimize(N)
    init_p, _ = get_metrics(init_s)

    # Convert -1/1 to 0/1 for the text file
    init_bin = "".join(['1' if x == 1 else '0' for x in init_s])
    final_bin = "".join(['1' if x == 1 else '0' for x in final_s])

    filename = f"optimized_sequence_{N}.txt"
    
    with open(filename, "w") as f:
        f.write("BINARY SEQUENCE AUTOCORRELATION REPORT\n")
        f.write("="*40 + "\n")
        f.write(f"Target Length: {N}\n")
        f.write(f"Prime Core Used: {p_used}\n")
        f.write(f"Patch Length: {patch_p}\n")
        f.write(f"Initial PSL: {init_p}\n")
        f.write(f"Final Optimized PSL: {final_p}\n")
        f.write("="*40 + "\n\n")
        
        f.write("INITIAL SEQUENCE (Legendre + Patch):\n")
        f.write(init_bin + "\n\n")
        
        f.write("FINAL OPTIMIZED SEQUENCE:\n")
        f.write(final_bin + "\n")

    print(f"\nDONE! Results saved to: {filename}")
    print(f"Final PSL Achieved: {final_p}")
    
    
    
