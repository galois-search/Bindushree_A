import numpy as np
import time

def get_psl(seq):
    """Calculates true integer Periodic PSL."""
    n = len(seq)
    f = np.fft.fft(seq)
    acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(int)
    return np.max(np.abs(acf[1:n//2+1]))

def get_sidelnikov_seed(n):
    """
    Generates a Sidelnikov (SLCE) sequence.
    Length N requires a prime p = N + 1.
    """
    p = n + 1
    # Check if n+1 is prime for Sidelnikov construction
    is_prime = all(p % i for i in range(2, int(p**0.5) + 1))
    if not is_prime:
        print(f"Note: {p} is not prime. Sidelnikov works best for p=N+1.")
        # We find the nearest prime to keep the math valid
        p_orig = p
        while not all(p % i for i in range(2, int(p**0.5) + 1)): p += 1
    
    # Find a primitive root alpha for p
    def get_primitive_root(p_val):
        for res in range(2, p_val):
            # Check a few factors to ensure it's a generator
            if pow(res, p_val-1, p_val) == 1:
                return res
        return 3

    alpha = get_primitive_root(p)
    seq = np.ones(n)
    
    # Construction: s(t) = 1 if (alpha^t + 1) is a non-residue mod p
    # This is the classic Sidelnikov mapping
    for t in range(n):
        val = (pow(alpha, t, p) + 1) % p
        if val == 0:
            seq[t] = 1
        elif pow(val, (p-1)//2, p) != 1: # Quadratic Non-Residue
            seq[t] = -1
        else:
            seq[t] = 1
    return seq[:n]

def save_dual_report(filename, n, init_seq, opt_seq, init_psl, opt_psl):
    """Saves both sequences with their PSLs to a text document."""
    def to_grid(arr):
        bin_str = "".join(['1' if x > 0 else '0' for x in arr])
        return "\n".join([f"[{i:05d}] {bin_str[i:i+100]}" for i in range(0, len(bin_str), 100)])

    with open(filename, 'w') as f:
        f.write("="*80 + "\n")
        f.write("SIDELNIKOV-BREST-BOSKOVIC OPTIMIZATION REPORT\n")
        f.write(f"Sequence Length (N): {n}\n")
        f.write(f"Initial Sidelnikov PSL: {init_psl}\n")
        f.write(f"Final Optimized PSL:    {opt_psl}\n")
        f.write("="*80 + "\n\n")

        f.write("INITIAL SIDELNIKOV SEQUENCE:\n" + "-"*30 + "\n")
        f.write(to_grid(init_seq))
        f.write("\n\n" + "="*80 + "\n\n")

        f.write("OPTIMIZED SEQUENCE:\n" + "-"*30 + "\n")
        f.write(to_grid(opt_seq))
    
    print(f"\nReport saved to: {filename}")

def main():
    # 1. User Inputs
    try:
        n = int(input("Enter Sequence Length (e.g., 10230): "))
    except ValueError:
        n = 10230

    print(f"Building Sidelnikov Seed for N={n}...")
    initial_seq = get_sidelnikov_seed(n).astype(np.float64)
    init_psl = get_psl(initial_seq)
    
    # 2. Optimization Setup
    seq = initial_seq.copy()
    f = np.fft.fft(seq)
    acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(float)
    
    best_seq = seq.copy()
    best_psl = init_psl
    gamma = 4.0
    start_time = time.time()

    print(f"Initial PSL: {init_psl} | Optimization started...")

    # 3. Brest-Boskovic Loop
    for step in range(1, 1000001):
        idx = np.random.randint(0, n)
        old_val = seq[idx]
        new_val = -old_val

        # O(N) Recursive Update
        diff = new_val - old_val
        indices_minus = (idx - np.arange(n)) % n
        indices_plus = (idx + np.arange(n)) % n
        delta = diff * (seq[indices_minus] + seq[indices_plus])

        test_acf = acf + delta
        
        # Energy Function (L-p Norm)
        curr_energy = np.sum(np.abs(acf[1:n//2+1])**gamma)
        new_energy = np.sum(np.abs(test_acf[1:n//2+1])**gamma)

        if new_energy < curr_energy:
            seq[idx] = new_val
            acf = test_acf
            curr_psl = np.max(np.abs(acf[1:n//2+1]))

            if curr_psl < best_psl:
                best_psl = int(curr_psl)
                best_seq = seq.copy()
                gamma = min(20, gamma + 0.1) # Focus on peaks
                print(f"Step {step:06d} | PSL: {best_psl} | Time: {time.time()-start_time:.1f}s")

                if best_psl <= np.sqrt(n): break

        # 20-minute limit for the user session
        if time.time() - start_time > 1200:
            print("Time limit reached.")
            break

    # 4. Final Verification and Save
    final_psl = get_psl(best_seq)
    filename = f"Sidelnikov_Report_N{n}.txt"
    save_dual_report(filename, n, initial_seq, best_seq, init_psl, final_psl)

if __name__ == "__main__":
    main()
    
    
