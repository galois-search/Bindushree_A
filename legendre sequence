import numpy as np
import time

def get_psl(seq):
    """Calculates the true integer Periodic PSL for verification."""
    n = len(seq)
    f = np.fft.fft(seq)
    acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(int)
    # Check first half due to periodic symmetry
    return np.max(np.abs(acf[1:n//2+1]))

def get_legendre_rotated(n):
    """Generates the initial Legendre sequence seed."""
    def is_prime(num):
        if num < 2: return False
        for i in range(2, int(num ** 0.5) + 1):
            if num % i == 0: return False
        return True

    p = n
    while not is_prime(p): p += 1

    s = np.ones(p)
    for i in range(1, p):
        if pow(i, (p - 1) // 2, p) != 1: s[i] = -1

    s = s[:n]
    return np.roll(s, n // 4)

def save_optimized_report(filename, n, init_seq, opt_seq, init_psl, opt_psl):
    """Saves a professional report with bit-grids and PSL results."""
    def format_grid(arr):
        bin_str = "".join(['1' if x > 0 else '0' for x in arr])
        rows = []
        for i in range(0, len(bin_str), 100):
            rows.append(f"[{i:05d}] {bin_str[i:i+100]}")
        return "\n".join(rows)

    with open(filename, 'w') as f:
        f.write("=" * 80 + "\n")
        f.write("BREST-BOSKOVIC SEQUENCE OPTIMIZATION REPORT\n")
        f.write(f"Generated on: {time.ctime()}\n")
        f.write(f"Sequence Length (N): {n}\n")
        f.write(f"Initial Seed PSL:    {init_psl}\n")
        f.write(f"Final Optimized PSL: {opt_psl}\n")
        f.write("=" * 80 + "\n\n")

        f.write("INITIAL SEQUENCE (BINARY GRID):\n")
        f.write("-" * 50 + "\n")
        f.write(format_grid(init_seq))
        f.write("\n\n" + "=" * 80 + "\n\n")

        f.write("OPTIMIZED SEQUENCE (BINARY GRID):\n")
        f.write("-" * 50 + "\n")
        f.write(format_grid(opt_seq))
        f.write("\n\n" + "=" * 80 + "\n")

def optimize_sequence():
    # 1. User Input
    try:
        n = int(input("Enter Sequence Length (e.g., 10230): "))
    except ValueError:
        print("Invalid input. Using default 10230.")
        n = 10230

    # 2. Initialization
    initial_seq = get_legendre_rotated(n).astype(np.float64)
    init_psl = get_psl(initial_seq)
    seq = initial_seq.copy()

    # Initial ACF using FFT (Normalization handled)
    f = np.fft.fft(seq)
    acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(float)
    
    best_seq = seq.copy()
    best_psl = init_psl
    gamma = 4.0  # Starting L-p norm exponent
    start_time = time.time()

    print(f"\n--- Starting Brest-Bošković Optimization ---")
    print(f"N: {n} | Initial PSL: {init_psl} | Target: ~{int(np.sqrt(n))}")

    # 3. Optimization Loop
    # 1 million steps or 30 minutes, whichever comes first
    for step in range(1, 1000001):
        idx = np.random.randint(0, n)
        old_val = seq[idx]
        new_val = -old_val

        # O(N) Recursive Difference Update (No FFT needed in loop)
        diff = new_val - old_val
        indices_minus = (idx - np.arange(n)) % n
        indices_plus = (idx + np.arange(n)) % n
        delta = diff * (seq[indices_minus] + seq[indices_plus])

        test_acf = acf + delta
        # Fitness: Minimizing Energy (L-p Norm) of sidelobes
        # Looking at indices 1 to N/2 due to Periodic Symmetry
        current_energy = np.sum(np.abs(acf[1:n//2+1]) ** gamma)
        new_energy = np.sum(np.abs(test_acf[1:n//2+1]) ** gamma)

        if new_energy < current_energy:
            seq[idx] = new_val
            acf = test_acf
            curr_psl = np.max(np.abs(acf[1:n//2+1]))

            if curr_psl < best_psl:
                best_psl = int(curr_psl)
                best_seq = seq.copy()
                gamma = min(18, gamma + 0.1) # Slowly sharpen focus on peaks
                print(f"Step {step:06d} | PSL: {best_psl} | Time: {time.time()-start_time:.1f}s")

                if best_psl <= np.sqrt(n):
                    print("Theoretical bound reached!")
                    break

        # Periodic Shake: Every 100k steps, flip 5 random bits to escape local traps
        if step % 100000 == 0:
            for _ in range(5):
                seq[np.random.randint(0, n)] *= -1
            f = np.fft.fft(seq)
            acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(float)

        # 30-minute timeout
        if time.time() - start_time > 1800:
            print("Time limit (30 min) reached.")
            break

    # 4. Final Save
    filename = f"Sequence_N{n}_PSL{best_psl}.txt"
    save_optimized_report(filename, n, initial_seq, best_seq, init_psl, best_psl)
    print(f"\nVerification Complete. Final PSL: {best_psl}")
    print(f"Results saved to: {filename}")

if __name__ == "__main__":
    optimize_sequence()
    
    
