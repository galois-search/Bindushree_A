import numpy as np

def is_prime(n):
    if n <= 1: return False
    if n <= 3: return True
    if n % 2 == 0 or n % 3 == 0: return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0: return False
        i += 6
    return True

def get_legendre_seq(p):
    """Generates ±1 Legendre sequence for prime p."""
    seq = np.zeros(p, dtype=int)
    for i in range(p):
        if i == 0:
            seq[0] = 1
        else:
            res = pow(i, (p - 1) // 2, p)
            seq[i] = 1 if res == 1 else -1
    return seq

def get_periodic_acr(seq):
    """Calculates max periodic autocorrelation sidelobe via FFT."""
    n = len(seq)
    f_transformed = np.fft.fft(seq)
    acf = np.real(np.fft.ifft(f_transformed * np.conj(f_transformed)))
    # Index 0 is the energy peak, check others for sidelobes
    sidelobes = np.abs(acf[1:])
    return np.max(sidelobes) if len(sidelobes) > 0 else 0

def get_cross_corr(seq1, seq2):
    """Calculates max cross-correlation between different length sequences."""
    n_total = len(seq1) + len(seq2)
    f1 = np.fft.fft(seq1, n_total)
    f2 = np.fft.fft(seq2, n_total)
    ccf = np.real(np.fft.ifft(f1 * np.conj(f2)))
    return np.max(np.abs(ccf))

def main():
    print("🔬 LEGENDRE EXHAUSTIVE SHIFT ANALYZER")
    print("-" * 40)

    try:
        p1 = int(input("Enter Prime 1 (4k+3): ").strip())
        p2 = int(input("Enter Prime 2 (4k+3): ").strip())

        if not (is_prime(p1) and is_prime(p2) and p1 % 4 == 3 and p2 % 4 == 3):
            print("❌ Invalid Input: Primes must be of form 4k+3.")
            return

        total_iterations = p1 * p2
        print(f"🔄 Calculating ALL {total_iterations} permutations...")
        print(f"📂 Output: LEGENDRE_FULL_REPORT.txt")

        s1_base = get_legendre_seq(p1)
        s2_base = get_legendre_seq(p2)

        with open("LEGENDRE_FULL_REPORT.txt", "w") as f:
            f.write(f"FULL EXHAUSTIVE ANALYSIS\nPrimes: {p1}, {p2}\nTotal Permutations: {total_iterations}\n")
            f.write("=" * 90 + "\n")
            f.write(f"{'Shift A':<8} | {'Shift B':<8} | {'PACF A':<10} | {'PACF B':<10} | {'Cross-Corr':<12} | {'Concat PACF'}\n")
            f.write("-" * 90 + "\n")

            count = 0
            for a in range(p1):
                # Pre-roll sa once per outer loop for efficiency
                sa = np.roll(s1_base, a)
                pacf_a = get_periodic_acr(sa)
                
                for b in range(p2):
                    sb = np.roll(s2_base, b)
                    
                    # Metrics
                    pacf_b = get_periodic_acr(sb)
                    cc = get_cross_corr(sa, sb)
                    
                    # Concatenation
                    concat_seq = np.concatenate([sa, sb])
                    pacf_concat = get_periodic_acr(concat_seq)

                    # Write results
                    f.write(f"{a:<8} | {b:<8} | {pacf_a:<10.2f} | {pacf_b:<10.2f} | {cc:<12.2f} | {pacf_concat:.2f}\n")
                    
                    # Progress indicator for large sets
                    count += 1
                    if count % 10000 == 0:
                        print(f"Progress: {count}/{total_iterations} ({(count/total_iterations)*100:.1f}%)")

        print("-" * 40)
        print(f"✅ SUCCESS: {total_iterations} rows written to LEGENDRE_FULL_REPORT.txt")

    except ValueError:
        print("❌ Error: Valid integers only.")
    except Exception as e:
        print(f"⚠️ Error: {e}")

if __name__ == "__main__":
    main()
    
