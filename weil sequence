import numpy as np
import time

def get_clean_psl(seq):
    """Calculates true integer periodic PSL."""
    n = len(seq)
    f = np.fft.fft(seq)
    # The Wiener-Khinchin result
    acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(int)
    # PSL is the max of the sidelobes (excluding the main lobe at index 0)
    return np.max(np.abs(acf[1:]))

def generate_weil_seed(n, shift=5):
    def is_prime(num):
        if num < 2: return False
        for i in range(2, int(num**0.5) + 1):
            if num % i == 0: return False
        return True

    p = n
    while not is_prime(p): p += 1

    legendre = np.ones(p)
    for i in range(1, p):
        if pow(i, (p - 1) // 2, p) != 1: legendre[i] = -1
    
    # Correct Weil Construction
    weil = legendre * np.roll(legendre, -shift)
    return weil[:n].astype(np.float64)

def optimize_weil_report(n):
    # 1. Start with Weil
    initial_seq = generate_weil_seed(n, shift=511 if n > 1000 else 5)
    
    # Calculate initial ACF correctly
    f = np.fft.fft(initial_seq)
    # Normalize and round to get actual integer correlation values
    acf = np.round(np.real(np.fft.ifft(f * np.conj(f)))).astype(float)
    
    init_psl = np.max(np.abs(acf[1:].astype(int)))
    best_psl = init_psl
    seq = initial_seq.copy()
    best_seq = initial_seq.copy()
    
    print(f"--- Optimization for N={n} ---")
    print(f"Initial PSL: {init_psl}")

    gamma = 4.0
    start_time = time.time()
    
    # 2. Optimization Loop
    for step in range(1, 1000000):
        idx = np.random.randint(0, n)
        old_val = seq[idx]
        new_val = -old_val

        # O(N) Update
        diff = new_val - old_val
        indices_minus = (idx - np.arange(n)) % n
        indices_plus = (idx + np.arange(n)) % n
        delta = diff * (seq[indices_minus] + seq[indices_plus])

        test_acf = acf + delta
        
        # Energy Function
        curr_e = np.sum(np.abs(acf[1:])**gamma)
        new_e = np.sum(np.abs(test_acf[1:])**gamma)

        if new_e < curr_e:
            seq[idx] = new_val
            acf = test_acf
            curr_psl = np.max(np.abs(acf[1:].astype(int)))
            
            if curr_psl < best_psl:
                best_psl = curr_psl
                best_seq = seq.copy()
                gamma = min(15, gamma + 0.1)
                print(f"Step {step} | PSL: {best_psl} | Time: {time.time()-start_time:.1f}s")
                
                if best_psl <= np.sqrt(n): break

        if time.time() - start_time > 600: # 10 min cap for this test
            break

    # 3. SAVE TO FILE
    filename = f"Report_N{n}_PSL{best_psl}.txt"
    with open(filename, "w") as f:
        f.write(f"Sequence Length: {n}\n")
        f.write(f"Initial PSL: {init_psl}\n")
        f.write(f"Final PSL: {best_psl}\n\n")
        f.write("OPTIMIZED SEQUENCE (1/0):\n")
        f.write("".join(['1' if x > 0 else '0' for x in best_seq]))
    
    print(f"Report saved to {filename}")
    return best_psl

if __name__ == "__main__":
    val = int(input("Enter Length: "))
    optimize_weil_report(val)
    
